POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=autosprint
DATABASE_URL=postgresql://admin:your_secure_password_here@db:5432/autosprint
SECRET_KEY=your_long_random_secret_here
ADMIN_PASSWORD=your_secure_admin_password_here
CORS_ORIGIN=http://localhost:3009
# Ollama running on the host machine (default). For the Docker-hosted Ollama use
# http://ollama:11434/api/generate and start with --profile docker-ollama.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen3:14b
# Optional. Some models (e.g. qwen3) emit a <think> reasoning block that can break JSON
# parsing. Set to "false" to disable it, "true" to force it on. Leave unset/blank to use
# the model's default (no "think" field sent to Ollama).
# OLLAMA_THINK=false
AI_PROVIDER=ollama
OPENAI_API_KEY=
GROQ_API_KEY=